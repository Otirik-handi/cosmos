NODE_ENV=development
COSMOS_VERSION=0.1.0
COSMOS_DATA_ROOT=.cosmos
DATABASE_URL=
COSMOS_API_HOST=127.0.0.1
COSMOS_API_PORT=4310
COSMOS_API_URL=http://localhost:4310
NEXT_PUBLIC_COSMOS_API_URL=
COSMOS_ALLOWED_ORIGIN=http://localhost:3000
COSMOS_WORKER_POLL_MS=30000
COSMOS_WORKER_LEASE_MS=120000
COSMOS_SSE_REPLAY_LIMIT=100
COSMOS_LOG_LEVEL=
COSMOS_LOG_OUTPUT=both
# Empty uses <COSMOS_DATA_ROOT>/logs.
COSMOS_LOG_ROOT=
COSMOS_LOG_RETENTION_DAYS=7
COSMOS_LOG_MAX_BYTES=268435456
COSMOS_OPENCLI_PATH=
OPENCLI_CONFIG_DIR=
OPENCLI_PROFILE=
