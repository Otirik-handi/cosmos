NODE_ENV=development
COSMOS_VERSION=0.1.0
COSMOS_DATA_ROOT=.cosmos
DATABASE_URL=
COSMOS_API_HOST=127.0.0.1
COSMOS_API_PORT=14310
COSMOS_API_URL=http://localhost:14310
NEXT_PUBLIC_COSMOS_API_URL=
# 部署形态的固定来源；`bun run dev` 会按实际 Web 端口自动覆盖此值。
# 必须与浏览器地址完全一致（含 host 写法）：用 127.0.0.1 打开页面就得填 127.0.0.1。
COSMOS_ALLOWED_ORIGIN=http://localhost:3000
# 模型配置写入允许的 API Host（逗号分隔，精确匹配，不认通配符）。
# 缺失或格式不合法时整个写信任集合为空：服务商/模型的保存全部 403，读取仍然正常。
# `bun run dev` 与 `bun run dev:api` 会按实际 API 端口自动注入，手工部署时必须显式设置。
COSMOS_MODEL_CONFIGURATION_AUTHORITIES=localhost:14310,127.0.0.1:14310
COSMOS_WORKER_POLL_MS=30000
COSMOS_WORKER_LEASE_MS=120000
COSMOS_SSE_REPLAY_LIMIT=100
COSMOS_LOG_LEVEL=
COSMOS_LOG_OUTPUT=both
# Empty uses <COSMOS_DATA_ROOT>/logs.
COSMOS_LOG_ROOT=
COSMOS_LOG_RETENTION_DAYS=7
COSMOS_LOG_MAX_BYTES=268435456
COSMOS_OPENCLI_PATH=
OPENCLI_CONFIG_DIR=
OPENCLI_PROFILE=
